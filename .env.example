# ---------------------------------------------------------------------------
# VYRA API — copy to .env at the repository root: cp .env.example .env
# Every value below is a LOCAL DEVELOPMENT value. Never reuse them in production.
# The API validates this file at boot and refuses to start if it is invalid.
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PORT=4100
# Comma-separated list of allowed browser origins (admin, Expo web).
CORS_ORIGINS=http://localhost:4101,http://localhost:8190

# PostgreSQL (docker compose service "postgres", exposed on 5440)
DATABASE_URL=postgresql://vyra:vyra_dev_password@localhost:5440/vyra?schema=public

# Auth — at least 32 characters each. Generate real ones with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# AI — only "mock" exists in the MVP. Real providers plug in behind AIProvider.
AI_PROVIDER=mock

# Weather — "mock" or "open-meteo" (Open-Meteo needs no API key).
WEATHER_PROVIDER=mock

# Storage — "local" (disk, dev only) or "s3" (any S3-compatible service).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# Public base URL the API is reachable at, used to build signed local URLs.
PUBLIC_API_URL=http://localhost:4100
# S3 / MinIO (docker compose service "minio") — used when STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=vyra-dev
S3_ACCESS_KEY_ID=vyra
S3_SECRET_ACCESS_KEY=vyra_dev_password
S3_FORCE_PATH_STYLE=true

# Billing — only "mock" in the MVP.
BILLING_PROVIDER=mock

# Analytics — only "mock" in the MVP (structured logs).
ANALYTICS_PROVIDER=mock

# Mail (password reset codes) — "mock" logs emails to the console.
MAIL_PROVIDER=mock

# Seed (development only) — password for every demo account created by `pnpm db:seed`.
SEED_DEMO_PASSWORD=VyraDemo2026!
