# Copy to apps/mobile/.env. Only EXPO_PUBLIC_* values reach the app bundle,
# so this file must never contain secrets (they would ship to every device).

# API base URL. On a physical phone, replace localhost with your computer's LAN IP
# (e.g. http://192.168.1.20:4100/api). Android emulator: http://10.0.2.2:4100/api
EXPO_PUBLIC_API_URL=http://localhost:4100/api
