{
  "expo": {
    "name": "VYRA",
    "slug": "vyra",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "vyra",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8F7F4",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.vyra.mobile"
    },
    "android": {
      "package": "app.vyra.mobile"
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F7F4"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "VYRA accède à tes photos pour ajouter des vêtements à ton dressing.",
          "cameraPermission": "VYRA utilise l’appareil photo pour photographier tes vêtements."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
