{
  "name": "@vyra/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tooling config (TypeScript, ESLint) and VYRA design tokens.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tokens": {
      "react-native": "./src/tokens.ts",
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.mjs",
      "require": "./dist/tokens.js"
    },
    "./eslint": "./eslint/base.mjs",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./tsconfig/nest.json": "./tsconfig/nest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "tsconfig",
    "eslint"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "tsup": "^8.5.1"
  },
  "module": "./dist/index.mjs"
}
