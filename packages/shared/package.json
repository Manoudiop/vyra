{
  "name": "@vyra/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas, enums and business constants shared by the VYRA API, mobile app and admin.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vyra/config": "workspace:*",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
